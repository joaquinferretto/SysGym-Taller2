<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </configSections>
    <connectionStrings>
        <!-- Reemplazar __SQL_SERVER_NAME__ por el servidor SQL Server real. -->
        <add name="GymContext"
             providerName="System.Data.SqlClient"
             connectionString="Data Source=__SQL_SERVER_NAME__;Initial Catalog=SysGymDB;Integrated Security=True;MultipleActiveResultSets=True;App=EntityFramework" />
    </connectionStrings>
    <entityFramework>
        <providers>
            <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
        </providers>
    </entityFramework>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
</configuration>

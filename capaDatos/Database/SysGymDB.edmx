        <ns3:EntityType Name="Pago">
          
    
          <ns3:Documentation>
            <ns3:Summary>Intentos de pago de cuotas con estado financiero e historial de anulaciones o reembolsos.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdRegistroPago"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdRegistroPago" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado del pago; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Fecha" Type="DateTime" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Fecha y hora en que el operador registró el pago en SysGym.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Descripcion" Type="String" MaxLength="500" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Detalle opcional del pago o su contexto.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Importe" Type="Decimal" Nullable="false" Precision="18" Scale="2">

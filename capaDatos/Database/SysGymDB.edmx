              <ns3:Summary>Identificador opcional del pago informado por Mercado Pago.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="MercadoPagoPreferenceId" Type="String" MaxLength="100" Unicode="true" FixedLength="false">

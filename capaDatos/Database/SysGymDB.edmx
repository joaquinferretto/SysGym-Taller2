          <ns3:AssociationSet Name="FK_UsuarioSistema_Creador" Association="SysGymModel.FK_UsuarioSistema_Creador">
            
      
            <ns3:End Role="UsuarioSistema" EntitySet="UsuarioSistema"/>
            
      
            <ns3:End Role="UsuarioSistema1" EntitySet="UsuarioSistema"/>
            
    
          </ns3:AssociationSet>
          
  
        </ns3:EntityContainer>
        
  
        <ns3:EntityType Name="AuditoriaOperacion">
          
    
          <ns3:Documentation>
            <ns3:Summary>Historial de operaciones auditadas, con responsable, fecha, entidad afectada y detalle.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdAuditoria"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdAuditoria" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado de la operación auditada; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="FechaHora" Type="DateTime" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Fecha y hora en que se registró la operación.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdUsuario" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea al usuario responsable de la operación.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="UsuarioNombre" Type="String" Nullable="false" MaxLength="201" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Copia del nombre del responsable al momento del evento para preservar el contexto histórico.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Rol" Type="String" Nullable="false" MaxLength="50" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Copia del rol del responsable al momento del evento.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Operacion" Type="String" Nullable="false" MaxLength="50" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Código de la acción realizada, por ejemplo REGISTRAR_PAGO o BAJA_SOCIO.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Entidad" Type="String" Nullable="false" MaxLength="50" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Tipo de registro afectado, por ejemplo Pago, Socio o Membresia.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdEntidad" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Identificador del registro afectado dentro de Entidad; no es FK porque el destino es polimórfico.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Detalle" Type="String" Nullable="false" MaxLength="1000" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Resumen contextual de la operación para su consulta en Auditoría.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="UsuarioSistema" Relationship="SysGymModel.FK_AuditoriaOperacion_Usuario" FromRole="AuditoriaOperacion" ToRole="UsuarioSistema"/>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="ConfiguracionSistema">
          
    
          <ns3:Documentation>
            <ns3:Summary>Parámetros globales de deuda, anticipación y avisos. Solo existe la fila IdConfiguracion = 1.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdConfiguracion"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdConfiguracion" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Identificador fijo de la configuración global; PK y CHECK restringen el valor a 1.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="MaxCuotasVencidasPermitidas" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Cantidad límite de cuotas pendientes vencidas; rango 1 a 120.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="MaxMesesAnticipacionCuotas" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Meses futuros permitidos al generar cuotas, además del período actual; rango 0 a 120.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="DiasAvisoVencimiento" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Días previos al vencimiento incluidos en los avisos; rango 0 a 365.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="CuotaMembresia">
          
    
          <ns3:Documentation>
            <ns3:Summary>Cargo de un período de membresía con importe histórico y estado de pago.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdCuotaMembresia"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdCuotaMembresia" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado de la cuota; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="FechaDesde" Type="DateTime" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Primer día del período cobrado.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="FechaHasta" Type="DateTime" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Último día incluido en el período cobrado.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Importe" Type="Decimal" Nullable="false" Precision="18" Scale="2">
            <ns3:Documentation>
              <ns3:Summary>Precio guardado al generar la cuota; no cambia con el precio futuro del plan.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="EstadoPago" Type="String" Nullable="false" MaxLength="20" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Estado de la cuota: Pendiente, Pagada o Anulada.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdRegistroPago" Type="Int32">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea opcional al pago vigente que determina el estado de la cuota.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdMembresia" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea a la membresía propietaria del período.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="Membresia" Relationship="SysGymModel.FK_CuotaMembresia_Membresia" FromRole="CuotaMembresia" ToRole="Membresia"/>
          
    
          <ns3:NavigationProperty Name="Pago" Relationship="SysGymModel.FK_CuotaMembresia_Pago" FromRole="CuotaMembresia" ToRole="Pago"/>
          
    
          <ns3:NavigationProperty Name="Pago1" Relationship="SysGymModel.FK_Pago_CuotaMembresia" FromRole="CuotaMembresia" ToRole="Pago"/>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="Ejercicio">
          
    
          <ns3:Documentation>
            <ns3:Summary>Catálogo de ejercicios disponibles para construir rutinas.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdEjercicio"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdEjercicio" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado del ejercicio; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Nombre" Type="String" Nullable="false" MaxLength="100" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Nombre mostrado en el catálogo y en las rutinas.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Descripcion" Type="String" MaxLength="500" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Descripción opcional del movimiento o los grupos musculares trabajados.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Estado" Type="Boolean" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Estado del ejercicio: 1 disponible, 0 dado de baja lógicamente.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="EjercicioImagen" Relationship="SysGymModel.FK_EjercicioImagen_Ejercicio" FromRole="Ejercicio" ToRole="EjercicioImagen"/>
          
    
          <ns3:NavigationProperty Name="RutinaEjercicio" Relationship="SysGymModel.FK_RutinaEjercicio_Ejercicio" FromRole="Ejercicio" ToRole="RutinaEjercicio"/>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="EjercicioImagen">
          
    
          <ns3:Documentation>
            <ns3:Summary>Imágenes asociadas a ejercicios, guardadas como rutas relativas y posiciones de presentación.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdEjercicioImagen"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdEjercicioImagen" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado de la imagen asociada; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdEjercicio" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea al ejercicio al que pertenece la imagen.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="RutaRelativa" Type="String" Nullable="false" MaxLength="260" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Ruta única del archivo dentro del almacenamiento de SysGym; la imagen queda fuera de SQL Server.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Orden" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Posición positiva en que se muestra la imagen del ejercicio.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="Ejercicio" Relationship="SysGymModel.FK_EjercicioImagen_Ejercicio" FromRole="EjercicioImagen" ToRole="Ejercicio"/>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="Membresia">
          
    
          <ns3:Documentation>
            <ns3:Summary>Vínculo histórico entre un socio, un plan, quien la registró y una rutina opcional.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdMembresia"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdMembresia" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado de la membresía; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="FechaInicio" Type="DateTime" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Fecha desde la que comienza la membresía.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="FechaVencimiento" Type="DateTime" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Fecha de vencimiento registrada; debe ser igual o posterior al inicio.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Estado" Type="Boolean" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Estado de la membresía: 1 activa, 0 inactiva; se conserva el historial.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdPlan" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea al plan asociado.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdSocio" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea al socio titular.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdUsuarioSistema" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea al Administrador o Recepcionista que la registró.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdRutina" Type="Int32">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea opcional a la rutina asignada; NULL mientras no se elija una.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="CuotaMembresia" Relationship="SysGymModel.FK_CuotaMembresia_Membresia" FromRole="Membresia" ToRole="CuotaMembresia"/>
          
    
          <ns3:NavigationProperty Name="Plan" Relationship="SysGymModel.FK_Membresia_Plan" FromRole="Membresia" ToRole="Plan"/>
          
    
          <ns3:NavigationProperty Name="Rutina" Relationship="SysGymModel.FK_Membresia_Rutina" FromRole="Membresia" ToRole="Rutina"/>
          
    
          <ns3:NavigationProperty Name="Socio" Relationship="SysGymModel.FK_Membresia_Socio" FromRole="Membresia" ToRole="Socio"/>
          
    
          <ns3:NavigationProperty Name="UsuarioSistema" Relationship="SysGymModel.FK_Membresia_UsuarioSistema" FromRole="Membresia" ToRole="UsuarioSistema"/>
          
    
          <ns3:NavigationProperty Name="MembresiaEntrenador" Relationship="SysGymModel.FK_MembresiaEntrenador_Membresia" FromRole="Membresia" ToRole="MembresiaEntrenador"/>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="MembresiaEntrenador">
          
    
          <ns3:Documentation>
            <ns3:Summary>Asignaciones históricas de entrenadores a membresías; la baja lógica conserva los cambios anteriores.</ns3:Summary>
          </ns3:Documentation>

            <ns3:PropertyRef Name="IdMembresiaEntrenador"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdMembresiaEntrenador" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado de la asignación; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Estado" Type="Boolean" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Estado de la asignación: 1 vigente, 0 finalizada o dada de baja.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdMembresia" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea a la membresía cuyo socio recibe seguimiento.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdEntrenador" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea al usuario con rol Entrenador asignado.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="Membresia" Relationship="SysGymModel.FK_MembresiaEntrenador_Membresia" FromRole="MembresiaEntrenador" ToRole="Membresia"/>
          
    
          <ns3:NavigationProperty Name="UsuarioSistema" Relationship="SysGymModel.FK_MembresiaEntrenador_UsuarioSistema" FromRole="MembresiaEntrenador" ToRole="UsuarioSistema"/>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="MercadoPago">
          
    
          <ns3:Documentation>
            <ns3:Summary>Referencias opcionales de Mercado Pago; SysGym no inicia cobros contra su API.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdNroPagoMP"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdNroPagoMP" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado del registro; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="MercadoPagoPaymentId" Type="String" MaxLength="100" Unicode="true" FixedLength="false">

              <ns3:Summary>Detalle opcional del estado recibido desde Mercado Pago.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="FechaAprobacion" Type="DateTime">
            <ns3:Documentation>
              <ns3:Summary>Fecha y hora opcional de aprobación informada para el pago.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="MetodoPago" Relationship="SysGymModel.FK_MetodoPago_MercadoPago" FromRole="MercadoPago" ToRole="MetodoPago"/>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="MetodoPago">
          
    
          <ns3:Documentation>

            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdUsuarioRegistro" Type="Int32">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea opcional al usuario que registró el pago; NULL en datos históricos sin responsable.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdCuotaMembresia" Type="Int32">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea opcional a la cuota correspondiente; se conserva al anular o reembolsar.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="CuotaMembresia" Relationship="SysGymModel.FK_CuotaMembresia_Pago" FromRole="Pago" ToRole="CuotaMembresia"/>
          
    
          <ns3:NavigationProperty Name="CuotaMembresia1" Relationship="SysGymModel.FK_Pago_CuotaMembresia" FromRole="Pago" ToRole="CuotaMembresia"/>
          
    
          <ns3:NavigationProperty Name="MetodoPago" Relationship="SysGymModel.FK_Pago_MetodoPago" FromRole="Pago" ToRole="MetodoPago"/>
          
    
          <ns3:NavigationProperty Name="UsuarioSistema" Relationship="SysGymModel.FK_Pago_UsuarioRegistro" FromRole="Pago" ToRole="UsuarioSistema"/>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="PagoEfectivo">
          
    
          <ns3:Documentation>
            <ns3:Summary>Detalle identificador de un método de pago en efectivo.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdPagoEfectivo"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdPagoEfectivo" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado del detalle de efectivo; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Estado" Type="Boolean" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Indica si el método de efectivo está habilitado: 1 sí, 0 no.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="MetodoPago" Relationship="SysGymModel.FK_MetodoPago_PagoEfectivo" FromRole="PagoEfectivo" ToRole="MetodoPago"/>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="Plan">
          
    
          <ns3:Documentation>
            <ns3:Summary>Catálogo de planes ofrecidos por el gimnasio y su precio vigente para cuotas futuras.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdPlan"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdPlan" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado del plan; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Nombre" Type="String" Nullable="false" MaxLength="100" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Nombre mostrado al crear o cambiar una membresía.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Descripcion" Type="String" MaxLength="500" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Descripción opcional de los servicios incluidos.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Precio" Type="Decimal" Nullable="false" Precision="18" Scale="2">
            <ns3:Documentation>
              <ns3:Summary>Precio vigente; las cuotas ya generadas conservan su importe histórico.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Estado" Type="Boolean" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Estado del plan: 1 habilitado para nuevas operaciones, 0 dado de baja.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="Membresia" Relationship="SysGymModel.FK_Membresia_Plan" FromRole="Plan" ToRole="Membresia"/>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="Rol">
          
    
          <ns3:Documentation>
            <ns3:Summary>Catálogo de roles que determina las funciones habilitadas para cada cuenta del sistema.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdRol"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdRol" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado del rol; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Descripcion" Type="String" Nullable="false" MaxLength="50" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Nombre único del rol asignable: Administrador, Recepcionista o Entrenador.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Estado" Type="Boolean" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Indica si el rol puede asignarse: 1 activo, 0 inactivo.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="UsuarioSistema" Relationship="SysGymModel.FK_UsuarioSistema_Rol" FromRole="Rol" ToRole="UsuarioSistema"/>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="Rutina">
          
    
          <ns3:Documentation>
            <ns3:Summary>Rutinas de entrenamiento creadas por un entrenador; los modelos tienen objetivo y nivel.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdRutina"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdRutina" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado de la rutina; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Nombre" Type="String" Nullable="false" MaxLength="100" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Nombre identificador de la rutina.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Descripcion" Type="String" MaxLength="500" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Descripción opcional de su finalidad o contenido.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="FechaCreacion" Type="DateTime" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Fecha de creación de la rutina.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="FechaInicio" Type="DateTime">
            <ns3:Documentation>
              <ns3:Summary>Inicio opcional del período previsto para la rutina.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="FechaFin" Type="DateTime">
            <ns3:Documentation>
              <ns3:Summary>Fin opcional del período previsto; no puede anteceder a FechaInicio si ambas existen.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Estado" Type="Boolean" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Estado de la rutina: 1 disponible, 0 dada de baja lógicamente.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Objetivo" Type="String" MaxLength="30" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Objetivo del modelo: Fuerza, Hipertrofia o Acondicionamiento; NULL para rutina libre.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Nivel" Type="String" MaxLength="20" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Nivel del modelo: Principiante, Intermedio o Avanzado; debe acompañar a Objetivo.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdEntrenador" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea al entrenador que creó y administra la rutina.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="Membresia" Relationship="SysGymModel.FK_Membresia_Rutina" FromRole="Rutina" ToRole="Membresia"/>
          
    
          <ns3:NavigationProperty Name="UsuarioSistema" Relationship="SysGymModel.FK_Rutina_Entrenador" FromRole="Rutina" ToRole="UsuarioSistema"/>
          
    
          <ns3:NavigationProperty Name="RutinaEjercicio" Relationship="SysGymModel.FK_RutinaEjercicio_Rutina" FromRole="Rutina" ToRole="RutinaEjercicio"/>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="RutinaEjercicio">
          
    
          <ns3:Documentation>
            <ns3:Summary>Parámetros de un ejercicio dentro de una rutina, ordenados por día y posición.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdRutinaEjercicio"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdRutinaEjercicio" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado del detalle de rutina; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Series" Type="Int32">
            <ns3:Documentation>
              <ns3:Summary>Cantidad opcional de series; si se informa debe ser mayor que cero.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Repeticiones" Type="Int32">
            <ns3:Documentation>
              <ns3:Summary>Repeticiones opcionales por serie; si se informan deben ser mayores que cero.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Peso" Type="Decimal" Precision="8" Scale="2">
            <ns3:Documentation>
              <ns3:Summary>Peso opcional de trabajo en kilogramos; no puede ser negativo.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Descanso" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Segundos de descanso; debe ser cero o mayor.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Orden" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Posición positiva del ejercicio dentro de la rutina.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="DiaSemana" Type="Int32">
            <ns3:Documentation>
              <ns3:Summary>Día opcional de entrenamiento: 1 a 5 corresponde a lunes a viernes.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Estado" Type="Boolean" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Estado del detalle: 1 incluido, 0 quitado lógicamente.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdRutina" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea a la rutina que contiene el ejercicio.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdEjercicio" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea al ejercicio del catálogo.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="Ejercicio" Relationship="SysGymModel.FK_RutinaEjercicio_Ejercicio" FromRole="RutinaEjercicio" ToRole="Ejercicio"/>
          
    
          <ns3:NavigationProperty Name="Rutina" Relationship="SysGymModel.FK_RutinaEjercicio_Rutina" FromRole="RutinaEjercicio" ToRole="Rutina"/>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="Socio">
          
    
          <ns3:Documentation>
            <ns3:Summary>Personas inscritas en el gimnasio, con sus datos personales, estado y medidas opcionales.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdSocio"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdSocio" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado del socio; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="DNI" Type="String" Nullable="false" MaxLength="20" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Documento de identidad único del socio; no se puede repetir.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Nombre" Type="String" Nullable="false" MaxLength="100" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Nombre de pila del socio.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Apellido" Type="String" Nullable="false" MaxLength="100" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Apellido del socio.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="FechaNacimiento" Type="DateTime">
            <ns3:Documentation>
              <ns3:Summary>Fecha de nacimiento opcional; se usa para validar la edad mínima de alta.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="FechaAlta" Type="DateTime">
            <ns3:Documentation>
              <ns3:Summary>Fecha de alta; NULL cuando no existe una fecha histórica confiable.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Peso" Type="Decimal" Precision="6" Scale="2">
            <ns3:Documentation>
              <ns3:Summary>Peso corporal opcional en kilogramos; si se informa debe ser positivo.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Altura" Type="Decimal" Precision="5" Scale="2">
            <ns3:Documentation>
              <ns3:Summary>Altura opcional en metros; si se informa debe ser positiva.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="FotoRuta" Type="String" MaxLength="260" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Ruta relativa de la fotografía guardada en disco; el archivo no se almacena en SQL Server.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Sexo" Type="String" MaxLength="1" Unicode="false" FixedLength="true">
            <ns3:Documentation>
              <ns3:Summary>Código opcional de un carácter: M o F.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Estado" Type="Boolean" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Estado del socio: 1 activo, 0 dado de baja; la baja conserva el historial.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="Membresia" Relationship="SysGymModel.FK_Membresia_Socio" FromRole="Socio" ToRole="Membresia"/>
          
  
        </ns3:EntityType>
        
  
        <ns3:EntityType Name="UsuarioSistema">
          
    
          <ns3:Documentation>
            <ns3:Summary>Cuentas del personal que inicia sesión y ejecuta operaciones en SysGym.</ns3:Summary>
          </ns3:Documentation>
          <ns3:Key>
            
      
            <ns3:PropertyRef Name="IdUsuarioSistema"/>
            
    
          </ns3:Key>
          
    
          <ns3:Property Name="IdUsuarioSistema" Type="Int32" Nullable="false" p1:StoreGeneratedPattern="Identity">
            <ns3:Documentation>
              <ns3:Summary>Identificador interno autogenerado de la cuenta; clave primaria.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Nombre" Type="String" Nullable="false" MaxLength="100" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Nombre de pila de la persona usuaria del sistema.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Apellido" Type="String" Nullable="false" MaxLength="100" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Apellido de la persona usuaria del sistema.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="DNI" Type="String" Nullable="false" MaxLength="20" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Documento de identidad único; no se puede repetir.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Telefono" Type="String" MaxLength="30" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Teléfono de contacto opcional del empleado.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="FechaNacimiento" Type="DateTime">
            <ns3:Documentation>
              <ns3:Summary>Fecha de nacimiento opcional del empleado.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Salario" Type="Decimal" Nullable="false" Precision="18" Scale="2">
            <ns3:Documentation>
              <ns3:Summary>Importe salarial registrado; SysGym no liquida ni paga salarios.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Username" Type="String" Nullable="false" MaxLength="50" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Nombre de usuario único usado para iniciar sesión.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Password" Type="String" Nullable="false" MaxLength="500" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Hash Argon2id de la contraseña; no debe contener la contraseña legible.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="FotoRuta" Type="String" MaxLength="260" Unicode="true" FixedLength="false">
            <ns3:Documentation>
              <ns3:Summary>Ruta relativa de la fotografía guardada en disco; el archivo no se almacena en SQL Server.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Sexo" Type="String" MaxLength="1" Unicode="false" FixedLength="true">
            <ns3:Documentation>
              <ns3:Summary>Código opcional de un carácter: M o F.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Estado" Type="Boolean" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Estado de la cuenta: 1 activa, 0 dada de baja.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdRol" Type="Int32" Nullable="false">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea al rol que define los permisos de la cuenta.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="IdUsuarioCreador" Type="Int32">
            <ns3:Documentation>
              <ns3:Summary>Clave foránea opcional a quien dio de alta esta cuenta; NULL para cuentas antiguas o iniciales.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:NavigationProperty Name="AuditoriaOperacion" Relationship="SysGymModel.FK_AuditoriaOperacion_Usuario" FromRole="UsuarioSistema" ToRole="AuditoriaOperacion"/>
          
    
          <ns3:NavigationProperty Name="Membresia" Relationship="SysGymModel.FK_Membresia_UsuarioSistema" FromRole="UsuarioSistema" ToRole="Membresia"/>
          
    

          <ns3:End Role="UsuarioSistema" Type="SysGymModel.UsuarioSistema" Multiplicity="1"/>
          
    
          <ns3:End Role="AuditoriaOperacion" Type="SysGymModel.AuditoriaOperacion" Multiplicity="*"/>
          
    

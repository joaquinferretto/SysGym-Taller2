              <ns3:Summary>Importe positivo asociado a este intento de pago.</ns3:Summary>
            </ns3:Documentation>
          </ns3:Property>
          
    
          <ns3:Property Name="Estado" Type="String" Nullable="false" MaxLength="20" Unicode="true" FixedLength="false">
            <ns3:Documentation>
